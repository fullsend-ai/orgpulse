{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scatter.schema.json",
  "title": "Scatter Visualization",
  "description": "Scatter plot rendered via Chart.js.",
  "type": "object",
  "required": ["type", "label", "description", "lastupdate", "data"],
  "properties": {
    "type": { "const": "scatter" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "lastupdate": { "type": "number" },
    "helpUrl": { "type": "string", "format": "uri" },
    "data": {
      "type": "object",
      "required": ["datasets"],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "data"],
            "properties": {
              "label": { "type": "string" },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "additionalProperties": true
                }
              },
              "backgroundColor": { "type": "string" },
              "borderColor": { "type": "string" },
              "pointRadius": { "type": "number" },
              "pointHoverRadius": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
