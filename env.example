PORT=9090
ENABLE_PPROF=false

# Dashboard database configuration (optional — enables /api/orgs, /api/products, /api/teams)
# All three of DASHBOARD_DB_USER, DASHBOARD_DB_PASSWORD, and DASHBOARD_DB_NAME must be set to enable the database.
DASHBOARD_DB_HOST=localhost
DASHBOARD_DB_PORT=3306
DASHBOARD_DB_USER=metricsconfig
DASHBOARD_DB_PASSWORD=changeme
DASHBOARD_DB_NAME=dashboard

# Path to a PEM CA bundle file (optional). When set, the MySQL connection uses
# TLS and verifies the server certificate against this CA -- needed for RDS
# instances with require_secure_transport enabled. Leave unset for local dev.
DASHBOARD_DB_TLS_CA_BUNDLE_PATH=

# Admin API key for bootstrapping REST API access (optional).
# API keys are optional and reserved for headless/scripted programmatic access
# (e.g. CI pipelines, curl, external automation). Browser UI users in
# production are authenticated via OAuth proxy and ADMIN_USERS without API keys.
# Generate with: openssl rand -hex 32
DASHBOARD_ADMIN_API_KEY=

# Key for encrypting stored integration/personal tokens (optional but
# recommended). Generate with: openssl rand -base64 32
# Once set, keep it: the server refuses to start without it. To remove or
# rotate it, first run `go run ./cmd/migrate decrypt-secrets` with the old key.
CONFIG_ENCRYPTION_KEY=

# Forwarded-identity auth & RBAC (optional — enables browser-based auth for /api/v1/*
# endpoints via a fronting ose-oauth-proxy-rhel9 sidecar that sets
# X-Forwarded-User / X-Forwarded-Email on every authenticated request).
# In OpenShift/production, browser users are transparently authenticated and
# granted Admin privileges if listed in ADMIN_USERS; no API keys needed.
# Only safe when this app is reachable exclusively through the proxy's port, never
# directly via the Service/Route. Without a proxy in front, CRUD features
# require a static API key instead.
#
# ADMIN_USERS: comma-separated list of OpenShift/Kerberos usernames (e.g. jdoe,alice)
# or '*' to treat any authenticated user as an administrator.
ADMIN_USERS=

# AUTH_EMAIL_DOMAINS: comma-separated email domains. When set, a bare name in
# ADMIN_USERS or a Rover export only matches emails in these domains (alice
# matches alice@example.com, not alice@other.org). Set it to your SSO domain.
AUTH_EMAIL_DOMAINS=

# DEV_ADMIN_OVERRIDE: unconditionally treats all requests as Admin (ideal for local dev,
# allowing full access without needing OAuth proxy or API keys).
DEV_ADMIN_OVERRIDE=false

# AUTH_TEST_MODE bypasses forwarded identity for local development, no proxy needed.
AUTH_TEST_MODE=false
AUTH_TEST_EMAIL=testuser@example.com
AUTH_TEST_IS_ADMIN=false
# Comma-separated Rover groups applied to the AUTH_TEST_MODE identity.
AUTH_TEST_GROUPS=

# Path to one Rover membership CSV, or a directory of them. A Rover export has
# no group column; the group name is the filename without .csv (testaisdlc.csv
# grants testaisdlc). A file that already has a group column uses that column.
# Reloaded when the files change. Do not commit a real export; mount the
# directory beside the process.
ROVER_GROUPS_CSV=
# Comma-separated Rover groups that can see and update every configured org.
# Members are not platform admins.
OPERATOR_ROVER_GROUPS=

# Report service (optional — enables POST /sendreport, which requires an admin).
# All four of AI_ANALYTICS_URL, AI_SUMMARY_URL, SMTP_HOST, and SMTP_FROM
# plus a configured database are required. Without them, /sendreport returns 503.
AI_ANALYTICS_URL=
AI_SUMMARY_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
REPORT_CHECK_INTERVAL_SECONDS=3600

# Workflow execution proxy (optional — enables /workflows/production/<name> proxy).
# Base URL of the internal workflow execution service. The dashboard proxies
# browser requests to this service since it is not directly reachable from
# outside the cluster.
WORKFLOW_EXEC_URL=http://localhost:7070

# DevLake database configuration (optional — enables workflow SQL queries and the admin SQL client).
# Points to the MySQL/MariaDB database that DevLake uses for its data.
DEVLAKE_DB_HOST=localhost
DEVLAKE_DB_PORT=3306
DEVLAKE_DB_USER=merico
DEVLAKE_DB_PASSWORD=merico
DEVLAKE_DB_NAME=lake

# Path to a PEM CA bundle file (optional). When set, the MySQL connection uses
# TLS and verifies the server certificate against this CA -- needed for RDS
# instances with require_secure_transport enabled. Leave unset for local dev.
DEVLAKE_DB_TLS_CA_BUNDLE_PATH=

# DevLake integration (optional — enables team sync with Apache DevLake).
# DEVLAKE_API_URL and a configured database are required to enable.
# DEVLAKE_API_URL: base URL of the DevLake REST API (e.g. http://devlake:8080/api/rest).
# DEVLAKE_API_KEY: bearer token for DevLake API authentication.
# DEVLAKE_CRON_CONFIG: base cron schedule for DevLake blueprint data collection.
#   Only the day-of-month, month, and day-of-week fields (3rd–5th) are used as-is.
#   The minute and hour are automatically spread per blueprint (derived from the
#   blueprint name) so that pipelines don't all fire at once. For example, the
#   default "0 0 * * *" runs each blueprint once daily, but at a different
#   minute and hour per blueprint. Set to "0 0 * * 1-5" to restrict to weekdays.
DEVLAKE_API_URL=
DEVLAKE_API_KEY=
DEVLAKE_CRON_CONFIG=0 0 * * *
# DEVLAKE_SKIP_TOKEN_TEST: set to true to skip the mandatory token validation
#   during team onboarding. Useful for local development where DevLake may not
#   be reachable. In production, leave unset or set to false — the UI will
#   require all tokens to pass a test-connection call before proceeding.
DEVLAKE_SKIP_TOKEN_TEST=false
