{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "teams.schema.json",
  "title": "Teams Configuration",
  "description": "Array of team definitions. Each team defines its data sources (git repos, Jira projects) and dashboards.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/team"
  },
  "definitions": {
    "team": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the team (kebab-case slug)."
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name."
        },
        "contactemail": {
          "type": "string",
          "format": "email",
          "description": "Contact email for the team lead."
        },
        "product": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Display names of the products this team belongs to."
        },
        "fetchurl": {
          "type": "string",
          "description": "DevLake data fetch trigger URL."
        },
        "fetchcheckurl": {
          "type": "string",
          "description": "DevLake pipeline status URL."
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" },
          "description": "Data sources (git repos and/or work-item trackers)."
        },
        "dashboards": {
          "type": "array",
          "items": { "$ref": "#/definitions/dashboard" },
          "description": "Team-level dashboards."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "type"],
      "oneOf": [
        { "$ref": "#/definitions/gitreposSource" },
        { "$ref": "#/definitions/workitemsSource" },
        { "$ref": "#/definitions/testsuitesSource" }
      ]
    },
    "gitreposSource": {
      "type": "object",
      "required": ["id", "type", "repos"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Source identifier (typically 'gitrepos')."
        },
        "type": {
          "type": "string",
          "const": "gitrepos"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Source-level configuration overrides."
        },
        "repos": {
          "type": "array",
          "items": { "$ref": "#/definitions/repo" },
          "description": "Git repositories tracked by this team."
        }
      }
    },
    "workitemsSource": {
      "type": "object",
      "required": ["id", "type", "projects"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Source identifier (e.g. 'aap-jira')."
        },
        "type": {
          "type": "string",
          "const": "workitems"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Source-level configuration overrides."
        },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/definitions/workitemProject" },
          "description": "Work-item tracker projects."
        }
      }
    },
    "testsuitesSource": {
      "type": "object",
      "required": ["id", "type", "projects"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Source identifier (always 'testsuites')."
        },
        "type": {
          "type": "string",
          "const": "testsuites"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "description": "Source-level configuration overrides."
        },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/definitions/testRegistryScope" },
          "description": "DevLake TestRegistry scopes collected for this team."
        }
      }
    },
    "testRegistryScope": {
      "type": "object",
      "required": ["id", "type", "projectname"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Scope identifier."
        },
        "projectname": {
          "type": "string",
          "description": "TestRegistry scope full name: the repo name for Openshift CI, '<quay-org>/<repo>' for Tekton CI."
        },
        "type": {
          "type": "string",
          "const": "testregistry"
        }
      }
    },
    "repo": {
      "type": "object",
      "required": ["id", "type", "owner", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Repo identifier (typically matches the repo name)."
        },
        "type": {
          "type": "string",
          "enum": ["github", "gitlab"],
          "description": "Source control platform."
        },
        "owner": {
          "type": "string",
          "description": "GitHub org or GitLab group that owns the repo."
        },
        "name": {
          "type": "string",
          "description": "Repository name."
        },
        "excludedDashboardTypes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dashboard types this repo should be excluded from (e.g. ['codecoverage'])."
        },
        "whitelist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "GitHub/GitLab usernames whose contributions are included. If absent, all contributors are included."
        }
      }
    },
    "workitemProject": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Project identifier."
        },
        "projectname": {
          "type": "string",
          "description": "Human-readable project name."
        },
        "jiraproject": {
          "type": "string",
          "description": "Jira project key (e.g. AAP, RHIDP)."
        },
        "boardid": {
          "type": "string",
          "description": "Jira Agile board ID (numeric)."
        },
        "type": {
          "type": "string",
          "enum": ["jira", "github"],
          "description": "Work-item tracker type (jira for Jira projects, github for GitHub Issues)."
        },
        "scope_config": {
          "$ref": "#/definitions/jiraScopeConfig"
        }
      }
    },
    "jiraScopeConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "DevLake scope config for Jira boards. Maps issue types to standard categories and specifies the story point field.",
      "properties": {
        "requirement_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Jira issue type names classified as requirements (e.g. Story, Task)."
        },
        "bug_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Jira issue type names classified as bugs (e.g. Bug, Defect)."
        },
        "story_point_field": {
          "type": "string",
          "description": "Jira field ID for story points (e.g. customfield_12310243)."
        }
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Dashboard identifier, unique within the team."
        },
        "type": {
          "type": "string",
          "description": "Dashboard type key (e.g. prcycletime, issuecycletime, ftpr, codecoverage, aicommitscanner)."
        },
        "title": {
          "type": "string",
          "description": "Display title shown in the dashboard tab."
        },
        "description": {
          "type": "string",
          "description": "HTML-safe description shown below the dashboard title."
        },
        "defaultsource": {
          "type": "string",
          "description": "ID of the source (repo or project) selected by default in the source filter."
        },
        "connectionid": {
          "type": "string",
          "description": "DevLake connection ID (used by issue-based dashboards)."
        },
        "jiraproject": {
          "type": "string",
          "description": "Jira project key (used by issue-based dashboards)."
        },
        "chaturl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the AI chat assistant endpoint."
        },
        "aianalyticsurl": {
          "type": ["string", "null"],
          "format": "uri",
          "description": "URL of the endpoint that returns AI analytics tooltips."
        },
        "diagrams": {
          "type": "array",
          "items": { "$ref": "#/definitions/diagram" },
          "description": "Ordered list of diagram widgets to render."
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["endpoint"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "Display order (0-based)."
        },
        "type": {
          "type": "string",
          "description": "Diagram source type (typically 'json')."
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "URL of the endpoint that returns the diagram data."
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "description": "Grid column span (1 = half width, 2 = full width)."
        },
        "title": {
          "type": "string",
          "description": "Optional override title for this diagram widget."
        },
        "aianalytics": {
          "type": "boolean",
          "default": false,
          "description": "Whether to fetch and show AI analytics tooltip for this diagram."
        },
        "description": {
          "type": "string",
          "description": "Optional description for this diagram widget (shown as tooltip or subtitle)."
        },
        "params": {
          "type": "object",
          "description": "Extra workflow request parameters for this diagram (e.g. {\"view\": \"criteria\"}). Merged into the request body; standard parameters are never overridden."
        }
      }
    }
  }
}
